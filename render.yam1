services:
    - type: web
    name: wahch-bot
    env: docker
    dockerfilePath: ./Dockerfile
    plan: free
    healthCheckPath: /
    envVars:
            - key: GROQ_API_KEY
        sync: false
            - key: UPSTASH_REDIS_REST_URL
        sync: false
            - key: UPSTASH_REDIS_REST_TOKEN
        sync: false
